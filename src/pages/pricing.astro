---
import Page from '../layouts/Page.astro';
---

<Page
  title="Pricing | UnsaidSignals"
  description="Simple, fair pricing for every team. One product, all features, unlimited manager seats."
  canonical="/pricing"
>
  <section class="mx-auto max-w-3xl px-4 py-32 text-center sm:px-6 lg:py-36">
    <h1 class="text-4xl font-bold tracking-tight text-foreground">Pricing</h1>
    <p class="mt-6 text-lg text-muted-foreground">Simple, fair pricing for every team. One product. All features. Unlimited manager seats.</p>
    <p class="mt-2 text-muted-foreground">Pricing scales only with your team size.</p>
    <a
      href="https://app.unsaidsignals.com"
      class="mt-8 inline-flex items-center rounded-full bg-primary px-8 py-3.5 text-base font-medium text-white hover:bg-primary/90 transition-colors"
    >
      Get Started
    </a>
  </section>
</Page>
