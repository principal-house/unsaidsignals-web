---
import Page from '../layouts/Page.astro';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UnsaidSignals',
  url: 'https://unsaidsignals.com',
  logo: 'https://unsaidsignals.com/favicon.svg',
  sameAs: ['https://x.com', 'https://www.linkedin.com'],
};

const stats = [
  { value: "78%", label: "of disengaged employees are invisible to leadership" },
  { value: "67%", label: "of executives blindsided by team issues" },
  { value: "3-6mo", label: "early warning before resignations" },
  { value: "$140K+", label: "average cost of replacing a mid-level employee" },
];

const problems = [
  { icon: "users", text: "Key people leave with no warning", subtext: "It's not the first time. And it won't be the last." },
  { icon: "trending-down", text: "Top performers suddenly disengage", subtext: "The spark fades. The momentum stalls." },
  { icon: "alert-triangle", text: "Conflicts escalate before resolution", subtext: "By the time it surfaces, the damage is done." },
  { icon: "eye", text: "Culture issues invisible until critical", subtext: "It's in the air, but where exactly?" },
  { icon: "message-square", text: "Missed signals from employee feedback", subtext: "Honest feedback falls through the cracks." },
];

const features = [
  { icon: "shield", title: "Retention Risk Detection", description: "Identify disengaged employees before they're out the door. Get real-time alerts and proactive intervention strategies.", dataPoint: "42% of turnover is preventable with early detection" },
  { icon: "heart", title: "Culture Health Monitoring", description: "Track organizational sentiment shifts and culture dynamics. Understand what's working and what needs attention.", dataPoint: "Psychological safety is #1 driver of team performance" },
  { icon: "users", title: "Team Dynamics Intelligence", description: "Deep dive into team-level trends, collaboration patterns, and manager effectiveness metrics.", dataPoint: "50-200% of salary: avg. cost of replacing one employee" },
  { icon: "trending-up", title: "Strength Indicator Signals", description: "Balance risk with positive insights. Celebrate what's going well and amplify team strengths.", dataPoint: "45% lower turnover when employees feel recognized" },
];

const whatWeDo = [
  { number: "1", title: "Weekly Pulse Check (90 seconds)", items: ["Anonymous, emotionally-safe, fast", "Measures clarity, energy, trust, morale, alignment", "Adaptive cadence to avoid fatigue"] },
  { number: "2", title: "AI-Generated Intelligence", items: ["Identify misalignment, interpersonal tension & performance drift", "Narrative explanation + leader-ready next steps", "Trend tracking and confidence scoring"] },
  { number: "3", title: "Real-Time Dashboard", items: ["Hotspots & friction detection", "Early attrition and burnout indicators", "Team confidence in leadership", "Cross-team comparisons, anonymously"] },
  { number: "4", title: "Action & Accountability Loop", description: "Leaders get visibility into action taken. Teams see follow-through. Trust builds." },
];

const personas = [
  { icon: "briefcase", title: "For Founders & CEOs", subtitle: "Fast clarity. Early warnings. Better decisions.", points: ["Protect company culture at scale", "Get ahead of resignation trends", "Keep senior leaders accountable and aware", "Understand team health at every stage"] },
  { icon: "building", title: "For C-Level & Functional Leaders", subtitle: "Full visibility. Strategic control over culture.", points: ["Department-level insights into engagement", "Minimize costly team churn", "Cross-functional perspective on employee sentiment", "Track improvement over time"] },
  { icon: "users", title: "For People & Talent Teams", subtitle: "Proactive tools. Real-time support for HR.", points: ["Shift from reactive to proactive retention", "Complement existing HRIS and engagement tools", "Early intervention capabilities", "Measure manager effectiveness discretely"] },
];

const tiers = [
  { employees: "1–10 employees", description: "Perfect for small teams getting started", price: "FREE", priceDetail: "forever", popular: false },
  { employees: "11–25 employees", description: "Growing teams ready to scale", price: "€10", priceDetail: "per employee / month", popular: false },
  { employees: "26–200 employees", description: "Scaling teams with growing needs", price: "€7", priceDetail: "per employee / month", popular: true },
  { employees: "200+ employees", description: "Enterprise scale with best value", price: "€5", priceDetail: "per employee / month", popular: false },
];
---

<Page
  title="UnsaidSignals | Team intelligence before issues become outcomes"
  description="UnsaidSignals surfaces early signals of misalignment, friction, and energy loss so leaders can act before performance declines."
  canonical="/"
  jsonLd={organizationJsonLd}
>

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden bg-background pb-20 pt-32 lg:pb-32 lg:pt-44">
    <div class="container">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="mb-6 text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl xl:text-7xl">
          See the signals. Act early. <span class="text-primary">Stay ahead.</span>
        </h1>
        <p class="mx-auto mb-12 max-w-2xl text-lg text-muted-foreground lg:text-xl">
          Weekly pulse checks that surface team clarity, energy, and trust issues — before they become crises. For
          founders, CEOs, and leaders who refuse to be surprised.
        </p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.unsaidsignals.com" class="inline-flex items-center rounded-full bg-primary px-8 py-3.5 text-base font-medium text-white shadow-soft hover:bg-primary/90 transition-colors">
            Book a Demo
          </a>
          <a href="#how-it-works" class="inline-flex items-center rounded-full px-8 py-3.5 text-base font-medium text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
            See how it works →
          </a>
        </div>
      </div>

      <!-- Stats Bar -->
      <div class="mx-auto mt-24 max-w-5xl">
        <p class="mb-8 text-center text-sm font-medium uppercase tracking-wider text-muted-foreground">
          The numbers that should keep you up at night
        </p>
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
          {stats.map((stat) => (
            <div class="rounded-[5px] bg-card p-6 text-center shadow-soft transition-all duration-300 hover:shadow-card">
              <div class="mb-2 font-mono text-3xl font-bold text-primary lg:text-4xl">{stat.value}</div>
              <p class="text-sm text-muted-foreground">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM SECTION -->
  <section class="bg-secondary py-24 lg:py-32">
    <div class="container">
      <div class="mb-8 flex justify-center">
        <span class="inline-flex items-center rounded-full px-4 py-1.5 text-sm font-medium bg-zinc-300 text-primary">
          THE CHALLENGE
        </span>
      </div>
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="mb-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          You feel it. But can't quite name it.
        </h2>
        <p class="text-lg text-muted-foreground">
          The subtle shifts. The missed deadlines that shouldn't have happened. The quiet resignation in meetings that
          used to overflow with ideas. Quarterly surveys are slow. Ad-hoc feedback is biased. And most dashboards show
          numbers, not reality.
        </p>
      </div>
      <div class="mx-auto max-w-4xl space-y-4">
        {problems.map((problem) => (
          <div class="flex items-start gap-5 rounded-[5px] bg-card p-6 shadow-soft transition-all duration-300 hover:shadow-card">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[5px] bg-[#f6f6f4]">
              {problem.icon === "users" && (
                <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 0 0-3-3.87" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
              )}
              {problem.icon === "trending-down" && (
                <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6" /><polyline points="17 18 23 18 23 12" /></svg>
              )}
              {problem.icon === "alert-triangle" && (
                <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
              )}
              {problem.icon === "eye" && (
                <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
              )}
              {problem.icon === "message-square" && (
                <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
              )}
            </div>
            <div>
              <h3 class="mb-1 text-lg font-semibold text-foreground">{problem.text}</h3>
              <p class="text-muted-foreground">{problem.subtext}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-12 text-center text-muted-foreground">
        You've seen it all before, but weren't quite able to name that feeling.
      </p>
    </div>
  </section>

  <!-- PROCESS SECTION (How It Works) -->
  <section id="how-it-works" class="bg-background py-24 lg:py-32">
    <div class="container">
      <div class="mx-auto mb-6 text-center">
        <span class="inline-block rounded-full px-4 py-1.5 text-xs font-medium uppercase tracking-wider text-[#23365c] bg-zinc-300">
          How It Works
        </span>
      </div>
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="mb-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          From signal to insight to action.
        </h2>
        <p class="text-lg text-muted-foreground">
          Weekly pulse checks that detect team health changes 3-6 weeks before they become crises.
        </p>
      </div>

      <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-3">
        <!-- Card 1: The Outcome -->
        <div class="rounded-[5px] border border-border bg-card p-6">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-[5px] bg-[#f6f6f4]">
            <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
          </div>
          <p class="mb-2 text-xs font-medium uppercase tracking-wider text-accent">The Outcome</p>
          <h3 class="mb-3 text-xl font-bold text-foreground">Early Warnings + Action Plans</h3>
          <p class="mb-6 text-sm text-muted-foreground">
            Get early people warnings, understand the root cause, and receive specific recommendations for what to do next.
          </p>
          <!-- UI Mockup -->
          <div class="rounded-[5px] border border-border bg-background p-4">
            <div class="mb-2 flex items-center gap-2">
              <svg class="h-4 w-4 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
              <span class="text-sm font-medium text-foreground">Issue Detected - Sarah Chen</span>
            </div>
            <p class="mb-3 text-xs text-muted-foreground">Week 46 → Week 49</p>
            <div class="space-y-1 text-xs">
              <div class="flex justify-between"><span class="text-muted-foreground">Clarity:</span><span>4 → 2 <span class="text-danger">(50% decline)</span></span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">Energy:</span><span>4 → 1 <span class="text-danger">(75% decline)</span></span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">Trust:</span><span>4 → 3 <span class="text-danger">(25% decline)</span></span></div>
            </div>
            <div class="mt-4 border-t border-border pt-3">
              <p class="text-xs font-medium text-foreground">Pattern: Energy crash + clarity drop</p>
              <p class="text-xs text-muted-foreground">
                <span class="font-medium text-primary">Action:</span> 1:1 within 48h. Discuss workload and role clarity.
              </p>
            </div>
          </div>
        </div>

        <!-- Card 2: The Rigor -->
        <div class="rounded-[5px] border border-border bg-card p-6">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-[5px] bg-[#f6f6f4]">
            <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20V10" /><path stroke-linecap="round" stroke-linejoin="round" d="M18 20V4" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 20v-4" /></svg>
          </div>
          <p class="mb-2 text-xs font-medium uppercase tracking-wider text-accent">The Rigor</p>
          <h3 class="mb-3 text-xl font-bold text-foreground">Multi-Level Analysis</h3>
          <p class="mb-6 text-sm text-muted-foreground">
            Track week-over-week trends across individuals, teams, and organization. Gaming-proof analysis.
          </p>
          <!-- UI Mockup -->
          <div class="rounded-[5px] border border-border bg-background p-4">
            <p class="mb-3 text-sm font-medium text-foreground">Engineering Team - Week 49</p>
            <div class="space-y-3">
              <div>
                <div class="mb-1 flex items-center justify-between text-xs">
                  <span class="text-muted-foreground">Clarity: 3.2</span>
                  <span class="text-muted-foreground">(Stable)</span>
                </div>
                <div class="h-2 rounded-full bg-muted"><div class="h-2 w-4/5 rounded-full bg-success"></div></div>
              </div>
              <div>
                <div class="mb-1 flex items-center justify-between text-xs">
                  <span class="text-muted-foreground">Energy: 2.1</span>
                  <span class="text-danger">↓ Declining</span>
                </div>
                <div class="h-2 rounded-full bg-muted"><div class="h-2 w-1/2 rounded-full bg-warning"></div></div>
              </div>
              <div>
                <div class="mb-1 flex items-center justify-between text-xs">
                  <span class="text-muted-foreground">Trust: 3.4</span>
                  <span class="text-success">(Good)</span>
                </div>
                <div class="h-2 rounded-full bg-muted"><div class="h-2 w-[85%] rounded-full bg-success"></div></div>
              </div>
            </div>
            <div class="mt-4 border-t border-border pt-3 text-xs">
              <p class="text-accent">Team trend: -18% over 3 weeks</p>
              <p class="mt-1 text-muted-foreground">
                <span class="font-medium">Note:</span> 2 outliers stable while team drops → Follow up to understand divergence
              </p>
            </div>
          </div>
        </div>

        <!-- Card 3: The Input -->
        <div class="rounded-[5px] border border-border bg-card p-6">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-[5px] bg-[#f6f6f4]">
            <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
          </div>
          <p class="mb-2 text-xs font-medium uppercase tracking-wider text-accent">The Input</p>
          <h3 class="mb-3 text-xl font-bold text-foreground">2-Minute Weekly Check</h3>
          <p class="mb-6 text-sm text-muted-foreground">
            Your team answers quick questions on Clarity, Energy, and Trust via Slack or email.
          </p>
          <!-- UI Mockup -->
          <div class="rounded-[5px] border border-border bg-background p-4">
            <div class="mb-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex h-6 w-6 items-center justify-center rounded bg-primary">
                  <span class="text-xs font-bold text-white">U</span>
                </div>
                <span class="text-sm font-medium text-foreground">UnsaidSignals</span>
              </div>
              <span class="text-xs text-muted-foreground">9:00 AM</span>
            </div>
            <p class="mb-2 text-sm font-medium text-foreground">Weekly pulse (3 questions):</p>
            <ol class="mb-4 space-y-1 text-xs text-muted-foreground">
              <li>1. Clarity on priorities? (1-4)</li>
              <li>2. Energy level? (1-4)</li>
              <li>3. Comfortable sharing? (1-4)</li>
            </ol>
            <div class="border-t border-border pt-3 text-xs text-muted-foreground">
              <p>Scale: 1=Not at all → 4=Absolutely</p>
              <p class="mt-1 italic">~90 seconds • Anonymous by default</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Privacy Footer -->
      <div class="mx-auto mt-12 max-w-4xl">
        <div class="flex items-start gap-4 rounded-[5px] border border-border bg-card p-6">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[5px] bg-[hsl(40,15%,92%)]">
            <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
          </div>
          <div>
            <h4 class="mb-1 font-bold text-foreground">Privacy-First Design</h4>
            <p class="text-sm text-muted-foreground">
              Responses can be anonymous or identified (your choice). We analyze aggregated patterns only—no 
              individual surveillance, no message monitoring, no invasive tracking.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section id="signals" class="bg-secondary py-24 lg:py-32">
    <div class="container">
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="mb-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          Built for the challenges you face every day
        </h2>
        <p class="text-lg text-muted-foreground">
          Comprehensive analytics designed for the real problems leaders encounter
        </p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {features.map((feature) => (
          <div class="group rounded-[5px] bg-card p-8 shadow-soft transition-all duration-300 hover:shadow-card">
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-[5px] bg-[#f6f6f4]">
              {feature.icon === "shield" && (
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
              )}
              {feature.icon === "heart" && (
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
              )}
              {feature.icon === "users" && (
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 0 0-3-3.87" /><path stroke-linecap="round" stroke-linejoin="round" d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
              )}
              {feature.icon === "trending-up" && (
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
              )}
            </div>
            <h3 class="mb-3 text-xl font-bold text-foreground">{feature.title}</h3>
            <p class="text-muted-foreground">{feature.description}</p>
            <div class="mt-4 flex items-center gap-2 text-sm font-medium text-accent">
              <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
              <span>{feature.dataPoint}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT WE DO SECTION -->
  <section id="what-we-do" class="bg-background py-24 lg:py-32">
    <div class="container">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="mb-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          What We Do
        </h2>
        <p class="text-lg text-muted-foreground">
          A lightweight pulse layer + real behavioral signals + AI-generated leadership intelligence.
        </p>
        <p class="mt-2 font-medium text-foreground">
          From Signal → Insight → Action.
        </p>
      </div>
      <div class="mx-auto mt-16 grid max-w-5xl gap-6 md:grid-cols-2">
        {whatWeDo.map((feature) => (
          <div class="rounded-[5px] border border-border bg-card p-6">
            <h3 class="mb-4 text-xl font-bold text-foreground">
              {feature.number}. {feature.title}
            </h3>
            {feature.items ? (
              <ul class="space-y-3">
                {feature.items.map((item) => (
                  <li class="flex items-start gap-2 text-muted-foreground">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-muted-foreground">{feature.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY LEADERS SECTION -->
  <section id="why-leaders" class="bg-secondary py-24 lg:py-32">
    <div class="container">
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="mb-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          Why Leaders Choose UnsaidSignals
        </h2>
        <p class="text-lg text-muted-foreground">
          Fast clarity. Early warnings. Better decisions.<br />
          All without requiring heavy lift or another process to manage.
        </p>
      </div>
      <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-3">
        {personas.map((persona) => (
          <div class="rounded-[5px] bg-card p-8 shadow-soft transition-all duration-300 hover:shadow-card">
