---
const features = [
  {
    title: 'Clarity Pulse',
    description: 'Know if your team understands the why, not just the what',
  },
  {
    title: 'Energy Signals',
    description: "Spot burnout and disengagement before it's too late",
  },
  {
    title: 'Trust Index',
    description: 'Measure psychological safety without awkward surveys',
  },
];
---

<section id="features" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-semibold tracking-tight text-zinc-100">Signals that leaders can act on</h2>
    <p class="mt-3 text-zinc-300">Three core signals reveal team health before performance drops or attrition spikes.</p>
  </div>
  <div class="mt-10 grid gap-5 md:grid-cols-3">
    {
      features.map((feature) => (
        <article class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-6">
          <div class="mb-4 h-10 w-10 rounded-lg bg-brand-500/20 text-brand-300">
            <svg viewBox="0 0 24 24" class="h-10 w-10 p-2" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 12h4l2-5 4 10 2-5h4" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-zinc-100">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-300">{feature.description}</p>
        </article>
      ))
    }
  </div>
</section>
