---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Page
  title="Blog | UnsaidSignals"
  description="Insights on team energy, trust, and leadership signals for engineering organizations."
  canonical="/blog"
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
    <h1 class="text-4xl font-semibold tracking-tight text-zinc-100">Blog</h1>
    <p class="mt-4 max-w-2xl text-zinc-300">Practical thinking on leading healthier, higher-clarity teams.</p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>
</Page>
