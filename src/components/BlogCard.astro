---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="rounded-[5px] bg-card p-6 transition hover:shadow-card">
  <p class="text-xs uppercase tracking-wide text-muted-foreground">{post.data.pubDate.toDateString()} · {post.data.author}</p>
  <h2 class="mt-3 text-xl font-bold text-foreground">
    <a class="hover:text-accent" href={`/blog/${post.slug}/`}>{post.data.title}</a>
  </h2>
  <p class="mt-3 text-muted-foreground">{post.data.description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {
      post.data.tags.map((tag) => (
        <span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">#{tag}</span>
      ))
    }
  </div>
</article>
