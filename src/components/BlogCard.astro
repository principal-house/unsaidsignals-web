---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-6 transition hover:border-zinc-700">
  <p class="text-xs uppercase tracking-wide text-zinc-400">{post.data.pubDate.toDateString()} · {post.data.author}</p>
  <h2 class="mt-3 text-xl font-semibold text-zinc-100">
    <a class="hover:text-brand-300" href={`/blog/${post.slug}/`}>{post.data.title}</a>
  </h2>
  <p class="mt-3 text-zinc-300">{post.data.description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {
      post.data.tags.map((tag) => (
        <span class="rounded-full border border-zinc-700 px-2.5 py-1 text-xs text-zinc-300">#{tag}</span>
      ))
    }
  </div>
</article>
